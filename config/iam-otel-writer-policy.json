{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WriteNativeCloudWatchOtelMetrics",
      "Effect": "Allow",
      "Action": "cloudwatch:PutMetricData",
      "Resource": "*"
    },
    {
      "Sid": "WriteCloudWatchOtelTraces",
      "Effect": "Allow",
      "Action": [
        "xray:PutTraceSegments",
        "xray:PutTelemetryRecords"
      ],
      "Resource": "*"
    },
    {
      "Sid": "WriteCloudWatchOtelLogs",
      "Effect": "Allow",
      "Action": "logs:PutLogEvents",
      "Resource": "arn:aws:logs:us-east-1:111122223333:log-group:/otel/replace-me:log-stream:*"
    }
  ]
}
